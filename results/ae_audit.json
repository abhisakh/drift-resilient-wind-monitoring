    },
    "which_path_produced_the_published_score": "not recoverable from the code alone",
    "seeded": false
  },
  "authors_protocol_read_from_paper": {
    "source": "CARE to Compare, Data 9(12):138 (2024), sec. 4.2.2; arXiv:2404.10320",
    "ae_trained_on": "75% of the normal training data, 25% validation",
    "architecture_and_hyperparameters": "tuned with Optuna",
    "threshold_farm_A_and_B": "adaptive: an NN predicts the expected reconstruction error, plus a per-farm sensitivity gamma",
    "gamma_tuned_with_optuna_per_farm": true,
    "threshold_farm_C": "fixed value chosen by maximising the F_1/2 score against ground truth derived from the status-IDs",
    "objective_of_the_search": "the CARE score itself",
    "held_out_tuning_protocol_documented": false,
    "conclusion": "the published 0.66 is a TUNED-ON-THE-BENCHMARK number, so it is not directly comparable with a leak-free score",
    "feature_scope_difference": "the AE sees the full sensor vector (power, wind, pitch, hydraulic, electrical); this project's detector sees only the thermal channels"
